{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "futureai-beige.vercel.app"
        }
      ],
      "destination": "https://www.futureai.it/$1",
      "permanent": true
    },
    {
      "source": "/report",
      "destination": "/report-gratuito/?da=volantino",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/report",
      "destination": "https://staisereno-ten.vercel.app/api/report-richiesta"
    },
    {
      "source": "/r/:slug",
      "destination": "https://staisereno-ten.vercel.app/api/report-pagina?s=:slug"
    },
    {
      "source": "/api/visita",
      "destination": "https://staisereno-ten.vercel.app/api/sito-visita"
    }
  ]
}